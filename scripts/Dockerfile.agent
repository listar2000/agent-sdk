# ── Stage 1: install the hivespace CLI from public PyPI (throwaway builder;
#    its /home/daytona/.local is COPYd into the final image). ──
# Token-free: `hivespace` is a public PyPI package, so there's no private-repo
# clone, no build credential, and nothing to bump per CLI release. The version
# baked here is only a BASELINE — hive-space's provision/reload installs the
# server-pinned version (HIVESPACE_VERSION) over it, so an agent self-heals to
# the right CLI at runtime regardless of what's frozen in the image.
FROM python:3.12-slim AS hivecli
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv
RUN mkdir -p /home/daytona && HOME=/home/daytona uv tool install hivespace

FROM node:22-bookworm-slim AS nodejs

FROM python:3.12-slim

WORKDIR /app

# Install Node.js 22 (required by the current Claude ACP adapter) plus zstd
# (used by supervisor.js
# for cold-tier snapshot compression — bench showed zstd-1 cuts artifact size
# ~10× with no wall-clock regression on a 1-vCPU sandbox; absence triggers
# a safe uncompressed fallback in supervisor.js but you lose the win).
RUN apt-get update && apt-get install -y --no-install-recommends curl git libstdc++6 zstd && rm -rf /var/lib/apt/lists/*
COPY --from=nodejs /usr/local/bin/node /usr/local/bin/node
COPY --from=nodejs /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# Install ``uv`` system-wide so AgentConfig.cli_tools (declarative ``uv tool
# install`` sources) works on every sandbox without bootstrap-in-pre_start.
# Per-tool binaries land in ``$HOME/.local/bin`` at install time; the
# supervisor adds that to PATH on ACP-child + /v1/exec spawns so the agent
# can invoke them. Pinning a recent version explicitly; uv has been stable
# but the install script defaults to ``latest`` and that breaks
# reproducible image builds.
RUN pip install --no-cache-dir uv

# Only the supervisor (ACP bridge + runtimes) — NOT the whole server source.
COPY src/supervisor src/supervisor

# Install the supervisor and its locked ACP runtimes. Adapters bring their
# compatible agent CLIs as package dependencies, avoiding floating globals.
# Do NOT pass --omit=optional: opencode-ai's postinstall needs the platform-
# specific opencode-linux-x64 (an optional dep) or it fails with "Cannot find
# module 'opencode-linux-x64/package.json'".
RUN cd src/supervisor && npm ci --loglevel=warn

# Symlink ``/opt/agent-sdk/runtime`` to the actual supervisor dir so
# providers that hardcode the canonical runtime path (daytona/modal/docker
# all reference ``/opt/agent-sdk/runtime`` inside the sandbox) still
# resolve. Both paths point at the same files; ``_runtime_acp_bin``
# resolves through ``package.json#bin`` so any ``.bin/`` symlink-flattening
# during image-build doesn't break supervisor spawn.
RUN mkdir -p /opt/agent-sdk && ln -s /app/src/supervisor /opt/agent-sdk/runtime
ENV AGENT_SDK_RUNTIME_PATH=/opt/agent-sdk/runtime

# ── bake: hivespace CLI (from the PyPI builder stage) + default skills ─────
COPY --from=hivecli /home/daytona/.local /home/daytona/.local
RUN export HOME=/home/daytona && mkdir -p $HOME/.claude/skills && npx -y skills add 'claude-office-skills/skills@html-slides' --yes -g && npx -y skills add 'github/awesome-copilot@excalidraw-diagram-generator' --yes -g && npx -y skills add 'anthropics/skills@frontend-design' --yes -g
CMD ["sleep", "infinity"]
