# ── Stage 1: build the private hivespace CLI (throwaway; token via the
#    build-context file hive_build_credentials.tmp, COPYd + rm'd here). ──
# The CLI ref is pinned to a concrete hive-space commit (not the moving
# @staging branch) on purpose: the install is a single RUN layer, so a
# branch ref never changes the command string and Docker/Daytona reuse the
# cached layer — silently baking a stale CLI even after staging moves. Pin
# to a SHA so the layer (and the snapshot) actually rebuild when the CLI
# changes. BUMP THIS on every CLI release: `git rev-parse origin/staging` in
# hive-space → paste below. (Follow-up: have release.sh resolve + inject it.)
FROM python:3.12-slim AS hivecli
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv
RUN mkdir -p /home/daytona
COPY hive_build_credentials.tmp /home/daytona/.git-credentials
RUN HOME=/home/daytona git config --global credential.helper store && chmod 600 /home/daytona/.git-credentials && HOME=/home/daytona uv tool install --with click "git+https://github.com/rllm-org/hive-space.git@b5546526b95a78e1862e4db563d0ec41e45bf423" && rm -f /home/daytona/.git-credentials

FROM python:3.12-slim

WORKDIR /app

# Install Node.js (required for ACP supervisor) plus zstd (used by supervisor.js
# for cold-tier snapshot compression — bench showed zstd-1 cuts artifact size
# ~10× with no wall-clock regression on a 1-vCPU sandbox; absence triggers
# a safe uncompressed fallback in supervisor.js but you lose the win).
RUN apt-get update && apt-get install -y --no-install-recommends curl nodejs npm git zstd && rm -rf /var/lib/apt/lists/*

# Agent CLI: only claude-code (the claude harness). opencode comes from the
# supervisor's node_modules; codex/gemini/cline/deepagents are not used.
RUN npm install -g @anthropic-ai/claude-code

# Install ``uv`` system-wide so AgentConfig.cli_tools (declarative ``uv tool
# install`` sources) works on every sandbox without bootstrap-in-pre_start.
# Per-tool binaries land in ``$HOME/.local/bin`` at install time; the
# supervisor adds that to PATH on ACP-child + /v1/exec spawns so the agent
# can invoke them. Pinning a recent version explicitly; uv has been stable
# but the install script defaults to ``latest`` and that breaks
# reproducible image builds.
RUN pip install --no-cache-dir uv

# Only the supervisor (ACP bridge + runtimes) — NOT the whole server source.
COPY src/supervisor src/supervisor

# Install the supervisor's ACP runtimes. package.json now lists only claude +
# opencode (codex/gemini/cline/deepagents are commented out in _disabledDependencies).
# Do NOT pass --omit=optional: opencode-ai's postinstall needs the platform-
# specific opencode-linux-x64 (an optional dep) or it fails with "Cannot find
# module 'opencode-linux-x64/package.json'".
RUN cd src/supervisor && npm install --loglevel=warn

# Symlink ``/opt/agent-sdk/runtime`` to the actual supervisor dir so
# providers that hardcode the canonical runtime path (daytona/modal/docker
# all reference ``/opt/agent-sdk/runtime`` inside the sandbox) still
# resolve. Both paths point at the same files; ``_runtime_acp_bin``
# resolves through ``package.json#bin`` so any ``.bin/`` symlink-flattening
# during image-build doesn't break supervisor spawn.
RUN mkdir -p /opt/agent-sdk && ln -s /app/src/supervisor /opt/agent-sdk/runtime
ENV AGENT_SDK_RUNTIME_PATH=/opt/agent-sdk/runtime

# ── bake: hivespace CLI (from builder, no token) + default skills ─────
COPY --from=hivecli /home/daytona/.local /home/daytona/.local
RUN export HOME=/home/daytona && mkdir -p $HOME/.claude/skills && npx -y skills add 'claude-office-skills/skills@html-slides' --yes -g && npx -y skills add 'github/awesome-copilot@excalidraw-diagram-generator' --yes -g && npx -y skills add 'anthropics/skills@frontend-design' --yes -g
CMD ["sleep", "infinity"]
