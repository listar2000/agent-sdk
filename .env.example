# agent-sdk server — honeycomb-compat deployment env template
# Copy the REQUIRED vars into the Railway service. This deployment targets the
# DAYTONA sandbox backend for honeycomb seed/task generation.

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# Postgres DSN. Attach a Railway Postgres addon and reference its URL. The
# schema self-bootstraps on startup (CREATE TABLE IF NOT EXISTS + idempotent
# migrations) — no manual migration step. Postgres is mandatory: every session
# and every stream event is persisted (this is what powers /log drop-recovery).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Daytona API key for the org that will host the sandboxes. The daytona provider
# raises RuntimeError at sandbox creation if this is unset.
DAYTONA_API_KEY=dtn_...

# HTTP port. Railway injects PORT automatically; the Dockerfile honors
# ${PORT:-7778}. Only set this for a local run.
# PORT=7778

# ── MUST NOT SET on the server ───────────────────────────────────────────────
# Model credentials are STRIPPED from the sandbox env (AUTH_KEYS in
# src/api/providers/_shared.py) and are never read from the server's own env.
# The honeycomb CLIENT forwards its OAuth token per-session as a sandbox secret.
# Do NOT set any of these on the deployment:
#   CLAUDE_CODE_OAUTH_TOKEN   ANTHROPIC_API_KEY   ANTHROPIC_FOUNDRY_AUTH_TOKEN
#   GITHUB_TOKEN

# ── OPTIONAL (daytona snapshot / image resolution) ───────────────────────────
# Snapshot precedence at sandbox creation: DAYTONA_SNAPSHOT env >
# .runtime-snapshot-tag file (committed: agent-sdk-46606ca). Leave BOTH unset to
# use the committed tag. Snapshots are per-Daytona-org: if this deployment uses
# a DIFFERENT org than staging/production, the committed snapshot will not exist
# there — either run `scripts/release.sh --provider daytona` under this
# DAYTONA_API_KEY to rebuild+register it (~5 min), or set the image-path fallback
# below (slower cold-create, but no pre-registration needed).
# DAYTONA_SNAPSHOT=agent-sdk-46606ca
# DAYTONA_IMAGE=            # or AGENT_SDK_IMAGE — image-path fallback (must carry the agent-sdk runtime at /opt/agent-sdk/runtime)
# AGENT_SDK_DAYTONA_POOL_MAX=300   # concurrent daytona sandbox cap (default 300)
# DAYTONA_CREATE_TIMEOUT_S=        # cold-create timeout override
# LOG_LEVEL=INFO
