> async function loadTaskInfo(name) {
>   const info = document.getElementById('taskInfo');
>   const taskName = name.replace(/^validate-/, '');
>   if (!taskName || taskName === name) { info.style.display = 'none'; return; }
> 
>   // Read metadata.json and first few lines of program.md via sandbox exec
>   // Use a lightweight approach: read from the shared filesystem
>   const tasksBase = '/checkpoint/ram-h100-2/tianhaowu/tasks';
>   const sessions = document.querySelectorAll('.session-item.active');
>   const activeSession = currentSessionId;
>   if (!activeSession) { info.style.display = 'none'; return; }
> 
>   try {
>     const r = await fetch(`${API}/sessions/${activeSession}/sandbox/exec`, {
>       method: 'POST',
>       headers: {'Content-Type': 'application/json'},
>       body: JSON.stringify({
>         command: `cat ${tasksBase}/${taskName}/metadata.json 2>/dev/null && echo '___SEP___' && head -20 ${tasksBase}/${taskName}/program.md 2>/dev/null`,
>         timeout: 5,
>       }),
>       signal: AbortSignal.timeout(8000),
>     });
>     if (!r.ok) { info.style.display = 'none'; return; }
>     const d = await r.json();
>     const parts = (d.stdout || '').split('___SEP___');
>     const metaRaw = parts[0]?.trim();
>     const programHead = parts[1]?.trim() || '';
> 
>     let meta = {};
>     try { meta = JSON.parse(metaRaw); } catch {}
> 
>     // Extract objective from program.md (first line after "## Objective")
>     let objective = '';
>     const lines = programHead.split('\n');
>     let inObj = false;
>     for (const line of lines) {
>       if (/^##\s*Objective/i.test(line)) { inObj = true; continue; }
>       if (inObj && line.startsWith('##')) break;
>       if (inObj && line.trim()) { objective += line.trim() + ' '; }
>     }
>     objective = objective.trim().slice(0, 200);
> 
>     info.innerHTML = `
>       <div class="ti-title">${escHtml(meta.title || taskName)}</div>
>       <div class="ti-row">Domain: <span>${escHtml(meta.domain || '?')}</span> &middot; arXiv: <span>${escHtml(meta.arxiv_id || '?')}</span> &middot; Score: <span>${meta.speedrun_score || '?'}/10</span></div>
>       ${objective ? `<div class="ti-obj">${escHtml(objective)}</div>` : ''}
>     `;
>     info.style.display = 'block';
>   } catch {
>     info.style.display = 'none';
>   }
> }
