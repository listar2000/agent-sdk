> function connectSSE(sessionId, body) {
>   // Close any prior SSE before opening a new one
>   if (currentEventSource) { currentEventSource.close(); currentEventSource = null; }
>   if (sessionId !== currentSessionId) return;
> 
>   const url = `${API}/sessions/${sessionId}/events`;
>   const es = new EventSource(url);
>   currentEventSource = es;
> 
>   es.onmessage = (msg) => {
>     if (sessionId !== currentSessionId) { es.close(); return; }
>     try {
>       const data = JSON.parse(msg.data);
>       if (data.jsonrpc && data.result) {
>         // Terminal or intermediate result
>         const result = data.result;
>         if (result.stopReason) {
>           appendEvent(body, 'done', {text: `Done (${result.stopReason})`});
>         }
>       } else if (data.jsonrpc && data.method === 'notifications/message') {
>         const update = data.params?.update;
>         if (!update) return;
>         const su = update.sessionUpdate;
>         if (su === 'text_message_start' || su === 'text_message_content') {
>           appendEvent(body, 'assistant_message', {text: update.messagePart?.text || update.textDelta || ''});
>         } else if (su === 'tool_call_begin') {
>           appendEvent(body, 'tool_call', {
>             name: update.toolName || '?',
>             input: update.input || update.arguments || '',
>           });
>         } else if (su === 'tool_call_result') {
>           appendEvent(body, 'tool_result', {
>             output: update.output || update.result || '',
>           });
>         } else if (su === 'thinking_message_start' || su === 'thinking_message_content') {
>           appendEvent(body, 'reasoning', {text: update.thinkingDelta || update.messagePart?.text || ''});
>         } else if (su === 'usage_update') {
>           appendEvent(body, 'usage', update);
>         }
>       }
>     } catch {}
>   };
> 
>   // Also listen for tagged events
>   es.addEventListener('error', () => {
>     if (sessionId !== currentSessionId) return;
>     appendEvent(body, 'system', {text: 'SSE connection closed'});
>   });
> }
