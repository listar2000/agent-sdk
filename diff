> // Extract tool name from various payload formats
> function extractName(p) {
>   return p.tool || p.name || p.tool_name || p.toolName || '?';
> }
> // Extract a short title for a tool call
> function extractTitle(p) {
>   if (p.title) return p.title;
>   const inp = p.input || p.args || {};
>   if (typeof inp === 'string') return inp.slice(0, 120);
>   if (inp.command) return inp.command.slice(0, 120);
>   if (inp.file_path || inp.filePath) return (inp.file_path || inp.filePath);
>   if (inp.path) return inp.path;
>   if (Object.keys(inp).length) return JSON.stringify(inp).slice(0, 120);
>   return '';
> }
> // Extract result text from various payload formats
> function extractResult(p) {
>   const res = p.result;
>   if (typeof res === 'string') return res;
>   if (Array.isArray(res)) return res.map(r => r.content?.text || r.text || JSON.stringify(r)).join('\n');
>   if (res && typeof res === 'object') return res.stdout || res.text || res.output || JSON.stringify(res);
>   return p.output || p.text || '';
> }
> 
> function appendEvent(body, type, payload) {
>   switch (type) {
>     case 'user_message': {
>       const div = document.createElement('div');
>       div.className = 'ev agent-text';
>       div.style.borderLeftColor = 'var(--success)';
>       div.innerHTML = `<div class="ev-label">User</div>${escHtml(payload.text || '')}`;
>       body.appendChild(div);
>       break;
>     }
>     case 'assistant_message': {
>       const text = payload.text || '';
>       if (!text.trim()) return;
>       const lastEl = body.lastElementChild;
>       if (lastEl?.dataset?.type === 'assistant_message') {
>         lastEl.innerHTML += escHtml(text);
>         body.scrollTop = body.scrollHeight;
>         return;
>       }
>       const div = document.createElement('div');
>       div.className = 'ev agent-text';
>       div.dataset.type = 'assistant_message';
>       div.innerHTML = `<div class="ev-label">Agent</div>${escHtml(text)}`;
>       body.appendChild(div);
>       break;
>     }
>     case 'tool_call': {
>       // Create a collapsible tool card
>       const toolName = extractName(payload);
>       const title = extractTitle(payload);
>       const toolCallId = payload.tool_call_id || payload.toolCallId || '';
> 
>       const details = document.createElement('details');
>       details.className = 'tool-card';
>       details.dataset.toolCallId = toolCallId;
>       details.dataset.toolName = toolName;
> 
>       const summary = document.createElement('summary');
>       summary.innerHTML = `<span class="tool-icon">▶</span> ${escHtml(toolName)} ${escHtml(title ? '· ' + title : '')}<span class="tool-status waiting">running</span>`;
> 
>       const pre = document.createElement('pre');
>       const args = payload.input || payload.args || {};
>       pre.textContent = typeof args === 'string' ? args : JSON.stringify(args, null, 2);
> 
>       details.append(summary, pre);
>       body.appendChild(details);
>       break;
>     }
>     case 'tool_result': {
>       // Find the last open tool card and add the result
>       const toolCallId = payload.tool_call_id || payload.toolCallId || '';
>       const cards = body.querySelectorAll('.tool-card');
>       let card = null;
> 
>       // Match by tool_call_id or find last card without result
>       for (let i = cards.length - 1; i >= 0; i--) {
>         if (toolCallId && cards[i].dataset.toolCallId === toolCallId) {
>           card = cards[i]; break;
>         }
>         if (!toolCallId && cards[i].querySelector('.tool-status.waiting')) {
>           card = cards[i]; break;
>         }
>       }
> 
>       if (card) {
>         // Update status
>         const status = card.querySelector('.tool-status');
>         if (status) { status.className = 'tool-status done'; status.textContent = 'done'; }
>         // Append result to pre
>         let output = extractResult(payload);
>         if (typeof output !== 'string') output = JSON.stringify(output);
>         if (output.length > 2000) output = output.slice(0, 2000) + '\n... (truncated)';
>         if (output.trim()) {
>           const pre = card.querySelector('pre');
>           pre.textContent += '\n─── result ───\n' + output;
>         }
>         card.querySelector('summary .tool-icon').textContent = '✓';
>       } else {
>         // Orphan result — show standalone
>         const div = document.createElement('div');
>         div.className = 'ev usage-ev';
>         let output = extractResult(payload);
>         if (typeof output !== 'string') output = JSON.stringify(output);
>         if (output.length > 500) output = output.slice(0, 500) + '...';
>         div.textContent = output || '(empty result)';
>         body.appendChild(div);
>       }
>       break;
>     }
>     case 'reasoning': {
>       const think = payload.text || '';
>       if (!think.trim()) return;
>       const lastThink = body.lastElementChild;
>       if (lastThink?.dataset?.type === 'reasoning') {
>         lastThink.innerHTML += escHtml(think);
