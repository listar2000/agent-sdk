> async function loadLog(sessionId, body) {
>   const log = await fetchJSON(`${API}/sessions/${sessionId}/log`);
>   if (!log || log.length === 0) {
>     body.innerHTML = '';
>     return;
>   }
>   body.innerHTML = '';
>   for (const e of log) {
